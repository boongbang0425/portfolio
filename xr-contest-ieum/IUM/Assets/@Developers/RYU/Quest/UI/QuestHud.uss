/* FixedUI 유리 디자인 토큰 (StartScene 월드 캔버스 · VRGlassButton 기준)
 * 패널(스모키 유리): rgba(72, 70, 82, 0.66) + 흰 제목 · 카드(흰 유리): rgba(255, 255, 255, 0.92)
 * 버튼: 흰 유리 0.94 → hover 1.0 → pressed rgb(125, 199, 255) · disabled 배경 α0.24, 전경 α0.28
 * 전경: rgb(25, 25, 25) α0.86 · 악센트: rgb(125, 199, 255) · 인디케이터 대기색: rgb(190, 217, 255)
 * 폰트: Giants-Bold · 모션: 배경 0.12s, hover 라벨 +6px, press scale 0.975
 *
 * 퀘스트 카드는 항상 게임 화면 위에 그늘 없이 뜨므로 버튼과 같은 흰 유리를 쓴다.
 * 상태 변형(attention/blocked/complete/error)은 흰 바탕에서 읽히도록 어두운 색조로 맞춘다. */

.quest-root {
    flex-grow: 1;
    align-items: flex-start;
    justify-content: flex-start;
    padding: 30px;
    color: rgb(25, 25, 25);
    -unity-font-definition: url("Fonts/Giants-Bold.ttf");
}

.quest-card {
    display: none;
    width: 460px;
    padding: 16px 18px 16px 12px;
    flex-direction: row;
    border-width: 1px;
    border-color: rgba(25, 25, 25, 0.1);
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.92);
}

.quest-card--visible {
    display: flex;
}

.quest-accent {
    width: 4px;
    min-width: 4px;
    margin-right: 16px;
    border-radius: 2px;
    background-color: rgb(125, 199, 255);
}

.quest-body {
    flex-grow: 1;
}

.quest-card--attention {
    border-width: 2px;
    border-color: rgba(224, 138, 0, 0.8);
    background-color: rgba(255, 246, 229, 0.95);
}

.quest-card--attention .quest-accent {
    background-color: rgb(224, 138, 0);
}

.quest-card--blocked {
    border-color: rgba(224, 138, 0, 0.5);
}

.quest-card--blocked .quest-accent,
.quest-card--blocked .quest-hint-mark,
.quest-card--blocked .quest-progress-fill {
    background-color: rgb(224, 138, 0);
}

.quest-card--blocked .quest-state {
    color: rgb(160, 98, 0);
}

.quest-card--complete {
    border-color: rgba(34, 168, 109, 0.7);
    background-color: rgba(230, 248, 239, 0.95);
}

.quest-card--complete .quest-accent,
.quest-card--complete .quest-hint-mark,
.quest-card--complete .quest-progress-fill {
    background-color: rgb(34, 168, 109);
}

.quest-card--complete .quest-state {
    color: rgb(21, 128, 82);
}

.quest-card--error {
    border-color: rgba(214, 69, 69, 0.75);
    background-color: rgba(253, 235, 237, 0.96);
}

.quest-card--error .quest-accent,
.quest-card--error .quest-hint-mark,
.quest-card--error .quest-progress-fill {
    background-color: rgb(214, 69, 69);
}

.quest-card--error .quest-state {
    color: rgb(178, 45, 45);
}

.quest-header,
.quest-state-row,
.quest-hint-row {
    flex-direction: row;
    align-items: center;
}

.quest-header {
    justify-content: space-between;
}

.quest-category,
.quest-section-label {
    font-size: 11px;
    color: rgba(25, 25, 25, 0.45);
    letter-spacing: 1px;
}

.quest-title {
    margin-top: 2px;
    font-size: 21px;
    color: rgb(25, 25, 25);
}

.quest-count {
    min-width: 62px;
    padding: 6px 10px;
    border-width: 1px;
    border-color: rgba(125, 199, 255, 0.9);
    border-radius: 10px;
    background-color: rgba(125, 199, 255, 0.18);
    font-size: 14px;
    -unity-text-align: middle-center;
    color: rgb(21, 101, 164);
}

.quest-divider {
    height: 1px;
    margin-top: 13px;
    margin-bottom: 12px;
    background-color: rgba(25, 25, 25, 0.12);
}

.quest-state-row {
    justify-content: space-between;
}

.quest-state {
    padding: 3px 8px;
    border-radius: 7px;
    background-color: rgba(25, 25, 25, 0.07);
    font-size: 11px;
    color: rgb(21, 101, 164);
}

.quest-goal {
    margin-top: 9px;
    font-size: 21px;
    white-space: normal;
    color: rgb(25, 25, 25);
}

.quest-progress {
    height: 6px;
    margin-top: 13px;
    border-radius: 3px;
    background-color: rgba(25, 25, 25, 0.12);
    overflow: hidden;
}

.quest-progress-fill {
    width: 0;
    height: 6px;
    border-radius: 3px;
    background-color: rgb(125, 199, 255);
}

.quest-hint-row {
    margin-top: 13px;
    padding: 10px 12px;
    border-width: 1px;
    border-color: rgba(25, 25, 25, 0.1);
    border-radius: 8px;
    background-color: rgba(25, 25, 25, 0.05);
}

.quest-hint-mark {
    width: 4px;
    min-width: 4px;
    height: 22px;
    margin-right: 10px;
    border-radius: 2px;
    background-color: rgb(125, 199, 255);
}

.quest-hint {
    flex-grow: 1;
    font-size: 14px;
    white-space: normal;
    color: rgba(25, 25, 25, 0.75);
}

.quest-skip {
    align-self: flex-end;
    margin-top: 10px;
    font-size: 11px;
    color: rgba(25, 25, 25, 0.4);
}
